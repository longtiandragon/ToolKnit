{
  "name": "knitspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first learning workbench for sources, mistakes and review.",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:e2e": "vue-tsc -b && vite build --mode e2e",
    "build:public": "vue-tsc -b && vite build --mode public",
    "preview": "vite preview",
    "check": "vue-tsc -b && vite build",
    "check:startup": "node scripts/check-startup-budget.mjs",
    "test": "vitest run",
    "check:public": "vitest run scripts/public-core-policy.test.mjs && node scripts/check-public-core.mjs",
    "check:public-history": "node scripts/check-public-history.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "checksum:release": "node scripts/write-release-checksums.mjs",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings -A clippy::too-many-arguments -A clippy::filter-next -A clippy::type-complexity -A clippy::identity-op -A clippy::unnecessary-sort-by -A clippy::single-char-add-str -A clippy::needless-as-bytes -A clippy::derivable-impls -A clippy::if-same-then-else -A clippy::needless-borrow",
    "check:rust:clippy:public": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features public-core -- -D warnings -A clippy::too-many-arguments -A clippy::filter-next -A clippy::type-complexity -A clippy::identity-op -A clippy::unnecessary-sort-by -A clippy::single-char-add-str -A clippy::needless-as-bytes -A clippy::derivable-impls -A clippy::if-same-then-else -A clippy::needless-borrow",
    "check:rust:clippy:e2e": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --features e2e -- -D warnings -A clippy::too-many-arguments -A clippy::filter-next -A clippy::type-complexity -A clippy::identity-op -A clippy::unnecessary-sort-by -A clippy::single-char-add-str -A clippy::needless-as-bytes -A clippy::derivable-impls -A clippy::if-same-then-else -A clippy::needless-borrow",
    "export:public": "node scripts/export-public-core.mjs",
    "benchmark:markdown": "node scripts/generate-markdown-benchmark.mjs",
    "benchmark:markdown:1mb": "node scripts/generate-markdown-benchmark.mjs --size=1",
    "benchmark:markdown:3mb": "node scripts/generate-markdown-benchmark.mjs --size=3",
    "benchmark:markdown:5mb": "node scripts/generate-markdown-benchmark.mjs --size=5",
    "benchmark:markdown:check": "node scripts/generate-markdown-benchmark.mjs --check",
    "benchmark:markdown:render": "node scripts/run-markdown-render-benchmark.mjs",
    "benchmark:markdown:gate": "pnpm run benchmark:markdown && node scripts/run-markdown-render-benchmark.mjs --check-budget --runs=5",
    "benchmark:markdown:all": "pnpm run benchmark:markdown:check && pnpm run benchmark:markdown:render",
    "desktop:dev": "tauri dev",
    "desktop:e2e:build": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json --features e2e",
    "desktop:e2e:run": "wdio run wdio.e2e.conf.mjs",
    "desktop:e2e": "pnpm desktop:e2e:build && pnpm desktop:e2e:run",
    "desktop:package:debug": "tauri build --debug --bundles nsis",
    "desktop:package": "tauri build --bundles nsis",
    "desktop:package:public": "tauri build --config src-tauri/tauri.public.conf.json --features public-core --bundles nsis",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lucide/vue": "^1.30.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.3.0",
    "@tauri-apps/plugin-fs": "^2.3.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@vueuse/core": "^12.8.2",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "js-yaml": "^4.1.0",
    "jsqr": "^1.4.0",
    "katex": "^0.16.22",
    "konva": "^10.3.0",
    "markdown-it": "^14.1.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.16.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^3.0.2",
    "qrcode": "^1.5.4",
    "ts-fsrs": "^5.2.1",
    "vue": "^3.5.18",
    "vue-konva": "^3.4.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.3",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.15",
    "@types/qrcode": "^1.5.6",
    "@unocss/preset-wind4": "^66.7.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "@wdio/cli": "9.31.1",
    "@wdio/globals": "9.31.1",
    "@wdio/local-runner": "9.31.1",
    "@wdio/mocha-framework": "9.31.1",
    "@wdio/spec-reporter": "9.31.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "playwright-core": "^1.62.1",
    "typescript": "~5.8.3",
    "unocss": "^66.7.5",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.12",
    "webdriverio": "9.31.1"
  }
}
