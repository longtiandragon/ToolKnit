{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Knitspace E2E",
  "identifier": "io.github.longtiandragon.toolknit.e2e",
  "build": {
    "beforeBuildCommand": "pnpm build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Knitspace · 本地数字工作台",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 680,
        "decorations": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "e2e-webdriver",
          "description": "Test-only WebDriver bridge for the isolated E2E binary.",
          "windows": ["main"],
          "permissions": ["wdio:default", "wdio-webdriver:default"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
